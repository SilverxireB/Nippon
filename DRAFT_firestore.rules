rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBudgetItem(data) {
      let requiredFields = ['description', 'amount', 'category', 'isSpent', 'date', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().size() == requiredFields.size() &&
             data.description is string && data.description.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             (data.amountJpy == null || (data.amountJpy is number && data.amountJpy >= 0)) &&
             data.category in ['fixed', 'activity', 'spending', 'accommodation', 'transport', 'food', 'shopping', 'other'] &&
             data.isSpent is bool &&
             data.date is string && // Simple check, could be more strict with regex if needed
             data.ownerId == request.auth.uid &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time;
    }

    // Rules for Budget Items
    match /users/{userId}/budgetItems/{itemId} {
      allow get, list: if isOwner(userId);
      
      allow create: if isOwner(userId) && 
                      isValidId(itemId) && 
                      isValidBudgetItem(incoming()) &&
                      incoming().createdAt == request.time;

      allow update: if isOwner(userId) && 
                      isValidBudgetItem(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().ownerId == existing().ownerId &&
                      (
                        // Action: Toggle Spent status
                        incoming().diff(existing()).affectedKeys().hasOnly(['isSpent', 'updatedAt']) ||
                        // Action: Full Edit
                        incoming().diff(existing()).affectedKeys().hasAny(['description', 'amount', 'amountJpy', 'category', 'date', 'updatedAt'])
                      );

      allow delete: if isOwner(userId);
    }
  }
}
